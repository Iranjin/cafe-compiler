// レジスタ演算: Load/Store Integer [10]/[11], Float [12]/[13], 演算 [14]/[15]
r0 = *(u32*)0x10000000;   // [10]
r0 += 5;                  // [14] 4 = 即値加算
r1 = r0 * 2 + r3;         // 左から順に計算
*(u32*)0x10000004 = r1;   // [11]

f0 = *(f32*)0x10000008;   // [12]
f0 *= 2.0;                // [15] 6 = 即値乗算
f1 = float(r0);           // int → float
r2 = int(f0);             // float → int
*(f32*)0x1000000C = f1;   // [13]
