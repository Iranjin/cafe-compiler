// 条件: 入れ子 / && / ビット判定 / between / ボタン入力
if (*(u16*)0x10000000 != 0 && (*(u32*)0x10000004 & 0x40) == 0x40) {   // [04] + [09]
    if (*(u8*)0x10000008 >= 3) {                                     // 入れ子は D2 で閉じる
        *(u8*)0x10000008 = 3;
    }
    *(u8*)0x10000009 = 1;
}

if (*(u32*)0x1000000C & 0x80) {          // いずれかのビット → [0A]
    *(u32*)0x10000010 = 1;
}

if (between(*(u16*)0x10000014, 10, 20)) {   // [0B]
    *(u16*)0x10000014 = 15;
}

if (button(VPAD_ZL | VPAD_R)) {          // [0E] GamePad の ZL+R
    *(u32*)0x10000018 = 1;
} else if (*(u32*)0x10000018 == 1) {
    *(u32*)0x10000018 = 0;
}
