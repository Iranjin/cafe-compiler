// ループ・タイマー・その他
loop (3) {                                    // [80] ... [D1]
    r4 += 1;
    if (*(u32*)0x10000000 == 9) { break; }    // [82]
}

loop (r4) {                                   // [81] レジスタ回数
    *(u32*)0x10000004 = 0;
}

timer (600) {                                 // [0C] ... [D2]  600 フレームの間だけ実行
    *(u32*)0x10000008 = 1;
}
reset_timer(*(u16*)0x1000000C == 1);          // [0D]

skip_write(*(u16*)0x10000100, 0x10, 4, 2, 1); // [02]
memfill(0x10000200, 0, 0x40);                 // [20]
memcpy(0x10000300, 0x10000400, 0x10);         // [21]
asm { 0x3D801100, 0x38600001, 0x906C0000 }    // [C0] 末尾に blr を自動付加

if (button(VPAD_PLUS)) {
    message("Hello!", 0x0000FF);              // [E0]
}
