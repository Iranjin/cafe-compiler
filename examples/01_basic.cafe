// 基本: メモリ書き込み (RAM Writes [00]) と if/else (If [03]-[08] + Negate [0F] + D0)
const COINS = 0x10000004;

if (*(u32*)0x10000000 == 1) {
    *(u16*)COINS = 0x63;
}

*(u8*)0x10000010 = 0xFF;      // 8bit
*(u16*)0x10000012 = 0x1234;   // 16bit
*(u32*)0x10000014 = -1;       // 32bit (2の補数で FFFFFFFF)
*(f32*)0x10000018 = 1.5;      // float はビット列 3FC00000 として書く

if (*(u32*)0x10000020 < 10) {
    *(u32*)0x10000020 = 999;
} else {
    *(u32*)0x10000020 = 0;
}
