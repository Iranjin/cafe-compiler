const HP = 0x10001000;
const BASE = 0x10A00000;

*(u8*)0x10000000 = 0xFF;
*(f32*)0x10000010 = 1.5;

if (*(u32*)HP < 10) {
    *(u32*)HP = 999;
} else if (*(u32*)HP == 50) {
    *(u32*)HP = 1;
} else {
    *(u32*)HP = 2;
}

if (*(u16*)0x10000020 != 0 && (*(u32*)0x10000024 & 0x40) == 0x40) {
    if (!(*(u8*)0x10000028 >= 3)) {
        *(u8*)0x10000028 = 3;
    }
    *(u8*)0x10000029 = 1;
}

pointer *(u32*)BASE in (0x10000000, 0x40000000) {
    *(u32*)(ptr + 0x20) = 99;
    if (*(u32*)(ptr + 0x24) == 0) {
        *(u16*)(ptr + 0x28) = 7;
    }
    ptr = *(u32*)(ptr + 0x10);
    ptr += 8;
    ptr -= r1 + 4;
    r2 = *(u32*)(ptr + 4);
}

*(u32*)(*(u32*)(*(u32*)BASE + 0x10) + 0x30) = 5;

if (*(u32*)(*(u32*)BASE + 0x8) > 3) {
    *(u32*)(*(u32*)BASE + 0xC) = 0;
}

r0 = *(u32*)0x10000040;
r0 += 5;
r1 = r0 * 2 + r3;
*(u32*)0x10000044 = r1;
f0 = *(f32*)0x10000048;
f0 *= 2.0;
f1 = float(r0);
r2 = int(f0);
*(f32*)0x1000004C = f1;

loop (3) {
    r4 += 1;
    if (*(u32*)0x10000050 == 9) { break; }
}
loop (r4) { *(u32*)0x10000054 = 0; }

timer (600) {
    *(u32*)0x10000058 = 1;
}
reset_timer(*(u16*)0x1000005C == 1);

if (button(VPAD_A | VPAD_B)) {
    message("Hello", 0x0000FF);
}
if (button(CLASSIC_ZL, CLASSIC, 1)) { clear_message(); }
if (between(*(u16*)0x10000060, 10, 20)) { *(u16*)0x10000060 = 15; }
if (*(u32*)0x10000064 & 0x80) { *(u32*)0x10000068 = 1; }
if ((*(u32*)0x10000064 & 0x80) == 0) { *(u32*)0x10000068 = 0; }

write(0x10000070, "ABCDEFGHI");
write(0x10000080, [0x01, 0x02, 0x03]);
skip_write(*(u16*)0x10000090, 0x10, 4, 2, 1);
memfill(0x100000A0, 0, 0x40);
memcpy(0x100000B0, 0x100000C0, 0x10);
corrupt(0x10000000, 0x10001000, 0xDEADBEEF, 0);
asm { 0x3D801100, 0x38600001, 0x906C0000 }
call(0x02000000);
syscall(0x1234);
hook_lr(0x02001234) { 0x38600001, 0x4E800020 }
raw(0x12345678, 0x9ABCDEF0);
